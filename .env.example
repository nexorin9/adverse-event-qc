# 不良事件上报数据质检系统 —— 环境变量样例
# 用法：cp .env.example .env 后逐项填写；.env 已被 .gitignore 排除，仓库不落任何密钥。
# 规则：以下九项全部从环境变量读取，缺任一项时启动即报错并点名变量名，不静默降级。

# ---- 入站 A：院内不良事件报告平台（HTTP 只读）----
# 平台根地址，例如 http://10.x.x.x:8080（不含末尾斜杠）
AE_BASE_URL=
# 读取上报数据的 Bearer 令牌；对应 GET {AE_BASE_URL}/api/v1/incident-reports
AE_API_TOKEN=

# ---- 出站：质控管理平台（真实写回，改变业务状态）----
# 质控平台根地址，例如 http://10.x.x.x:9090
QC_BASE_URL=
# 写回发现单的 Bearer 令牌；对应 POST {QC_BASE_URL}/api/v1/quality-findings
QC_TOKEN=

# ---- 模型：语义归并与归因（OpenAI-compatible 协议）----
# 推理服务端点，例如 http://10.x.x.x:8000/v1
MODEL_BASE_URL=
# 模型访问令牌
MODEL_API_KEY=
# 模型名，例如 qwen2.5-14b-instruct（由院内自建推理服务决定）
MODEL_NAME=
# 单次调用超时秒数，默认 30
MODEL_TIMEOUT=30

# ---- 期望套件 ----
# 本次跑批使用的期望套件版本（catalogs/rulesets/ 下的版本号，如 v2026-01）
# 留空表示使用当前生效版本
AE_RULE_SET=
